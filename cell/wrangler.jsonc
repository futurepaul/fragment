{
  "name": "fragment",
  // entry.mjs is the JavaScript shim around the Rust build (build/index.js):
  // workers-rs classes do not extend DurableObject, which celld requires for
  // RPC, so the shim declares the classes and forwards to Rust.
  "main": "entry.mjs",
  "compatibility_date": "2026-01-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  // One Workflow instance per run of a job or triggered operation (jobs.rs).
  "workflows": [{ "name": "fragment-jobs", "binding": "JOBS", "class_name": "Job" }],
  // Blobs: the bytes of files of 1 MiB or more (blobs.rs), in the fleet bucket.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "fragment-blobs" }],
  // Deliveries: web push and notifyUrls, sent outside any request (deliveries.rs).
  "queues": {
    "producers": [{ "binding": "DELIVERIES", "queue": "fragment-deliveries" }],
    "consumers": [
      { "queue": "fragment-deliveries", "max_batch_size": 20, "max_batch_timeout": 1, "max_retries": 5, "dead_letter_queue": "fragment-deliveries-dead" },
      { "queue": "fragment-deliveries-dead", "max_batch_timeout": 1 }
    ]
  },
  // The node's keys (crates/native, docs/hardening.md H1): sealing, the
  // code.storage JWT, WorkOS's exchange, OpenRouter's key API. Needs our
  // celld fork, which routes `native:*` targets to that crate.
  "services": [{ "binding": "KEYS", "service": "native:keys" }],
  "durable_objects": {
    "bindings": [
      { "name": "FRAGMENT", "class_name": "Fragment" },
      { "name": "PRINCIPAL", "class_name": "Principal" },
      // The identity registry: one cell for the fleet (registry.rs).
      { "name": "REGISTRY", "class_name": "Registry" },
      // A billing org's budget and usage: one cell per org (ledger.rs).
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Fragment"] },
    { "tag": "v2", "new_sqlite_classes": ["Principal"] },
    { "tag": "v3", "new_sqlite_classes": ["Registry"] },
    { "tag": "v4", "new_sqlite_classes": ["Ledger"] }
  ]
}
