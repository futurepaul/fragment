{
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "containers_pid_namespace"
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Computer",
        "name": "COMPUTER"
      },
      {
        "class_name": "Fragment",
        "name": "FRAGMENT"
      },
      {
        "class_name": "Principal",
        "name": "PRINCIPAL"
      },
      {
        "class_name": "Registry",
        "name": "REGISTRY"
      },
      {
        "class_name": "Ledger",
        "name": "LEDGER"
      }
    ]
  },
  "main": "entry.mjs",
  "migrations": [
    {
      "new_sqlite_classes": [
        "Fragment",
        "Principal",
        "Registry",
        "Ledger",
        "Computer"
      ],
      "tag": "v1"
    }
  ],
  "name": "fragment",
  "queues": {
    "consumers": [
      {
        "dead_letter_queue": "fragment-deliveries-dead",
        "max_batch_size": 20,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "queue": "fragment-deliveries"
      },
      {
        "max_batch_timeout": 1,
        "queue": "fragment-deliveries-dead"
      },
      {
        "max_batch_size": 20,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "queue": "fragment-ledger"
      }
    ],
    "producers": [
      {
        "binding": "DELIVERIES",
        "queue": "fragment-deliveries"
      },
      {
        "binding": "METERS",
        "queue": "fragment-ledger"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "fragment-blobs"
    }
  ],
  "services": [
    {
      "binding": "AGENTS",
      "service": "fragment-agent"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "workflows": [
    {
      "binding": "JOBS",
      "class_name": "Job",
      "name": "fragment-jobs"
    }
  ]
}