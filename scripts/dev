#!/usr/bin/env bash
# fragment dev environment: celld dev (local object store) + the mock
# code.storage server (tests/dev file plane) — native processes, no docker.
# verbs: up | down | deploy | status | logs | wipe
# CELLD_BIN=<path> runs another celld build (the fork in celld-worktrees)
#
# Local world persists in .dev/celld-state (cells, via the runtime/.celld
# symlink) — file bytes live in code.storage (the mock for local dev).
set -euo pipefail
cd "$(dirname "$0")/.."
DEV=.dev
TOOLS="$DEV/tools"
CELLD_PORT=8789
CS_MOCK_PORT=9940
FAL_FAKE_PORT=9942

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
mkdir -p "$DEV"

# Optional project .env: OPENROUTER_API_KEY=..., FAL_API_KEY=... (never committed)
if [ -f .env ]; then set -a; . ./.env; set +a; fi
for keyfile in "$HOME/dev/finite/fragment/.env"; do
  if [ -z "${OPENROUTER_API_KEY:-}" ] && [ -f "$keyfile" ]; then
    OPENROUTER_API_KEY="$(grep -o '^OPENROUTER_API_KEY=.*' "$keyfile" | head -1 | cut -d= -f2-)"
    export OPENROUTER_API_KEY
  fi
done

tools() {
  # celld dev bundles the runtime with esbuild (CELLD_ESBUILD when not on PATH)
  if [ ! -x "$TOOLS/node_modules/.bin/esbuild" ]; then
    mkdir -p "$TOOLS"
    (cd "$TOOLS" && [ -f package.json ] || npm init -y >/dev/null; npm install esbuild >/dev/null)
  fi
}

celld_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$CELLD_PORT/__internal/ping"; }
cs_mock_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$CS_MOCK_PORT/healthz"; }

# the mock code.storage server (runtime/test/mock-codestorage.mjs): the
# local-dev stand-in for the real file plane — repos (url-form identity),
# commit-packs with expected-parent CAS, file streams, branch heads,
# branch create/merge/restore (the CLI's deploy/preview/rollback plane)
start_cs_mock() {
  if cs_mock_running; then echo "cs-mock: already running on :$CS_MOCK_PORT"; return; fi
  MOCK_ORG_PRIV="$(cat "$DEV/cs-org-key.pem")" \
    nohup node runtime/test/mock-codestorage.mjs "$CS_MOCK_PORT" "$DEV/cs-mock-root" > "$DEV/cs-mock.log" 2>&1 &
  echo $! > "$DEV/cs-mock.pid"
  for _ in $(seq 1 20); do cs_mock_running && break; sleep 0.5; done
  cs_mock_running || { echo "cs-mock: did not come up; last log lines:" >&2; tail -10 "$DEV/cs-mock.log" >&2; exit 1; }
  echo "cs-mock: started on :$CS_MOCK_PORT (state in $DEV/cs-mock-root)"
}

start_fal_fake() {
  fal_fake_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$FAL_FAKE_PORT/health"; }
  if fal_fake_running; then echo "fal-fake: already running on :$FAL_FAKE_PORT"; return; fi
  nohup node scripts/fal-fake.mjs "$FAL_FAKE_PORT" > "$DEV/fal-fake.log" 2>&1 &
  echo $! > "$DEV/fal-fake.pid"
  for _ in $(seq 1 20); do fal_fake_running && break; sleep 0.5; done
  fal_fake_running || { echo "fal-fake: did not come up; last log lines:" >&2; tail -10 "$DEV/fal-fake.log" >&2; exit 1; }
  echo "fal-fake: started on :$FAL_FAKE_PORT (stand-in fal queue for e2e)"
}

# celld 0.5 takes Worker variables from runtime/.dev.vars (dotenv, one line
# per value; the runtime turns literal \n back into newlines for the PEM).
# The file holds secrets: mode 600, gitignored, rewritten on every `up`.
DEV_VARS=runtime/.dev.vars
devvar() {
  local value="${2//$'\n'/\\n}"
  printf '%s=%s\n' "$1" "$value" >> "$DEV_VARS.tmp"
}

celld_env() {
  rm -f "$DEV_VARS.tmp"; ( umask 077; : > "$DEV_VARS.tmp" )
  devvar FRAGMENT_INTERNAL_URL "http://127.0.0.1:$CELLD_PORT"
  export CELLD_ESBUILD="$PWD/$TOOLS/node_modules/.bin/esbuild"
  # wrapped-secret storage (level-c) REQUIRES a host secret; a throwaway
  # persisted next to the org key so restarts keep cells decryptable.
  # An operator/CI-provided FRAGMENT_HOST_SECRET wins (exported as-is);
  # either way the e2e process sees the same value the host runs.
  if [ -z "${FRAGMENT_HOST_SECRET:-}" ]; then
    if [ ! -f "$DEV/host-secret" ]; then
      node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))" > "$DEV/host-secret"
    fi
    export FRAGMENT_HOST_SECRET="$(cat "$DEV/host-secret")"
  fi
  devvar FRAGMENT_HOST_SECRET "$FRAGMENT_HOST_SECRET"
  # code.storage file plane: the local mock + a throwaway org key. The
  # mock gets the PRIVATE half (MOCK_ORG_PRIV) so it actually verifies the
  # JWTs the runtime mints — the same discipline the real service has.
  if [ ! -f "$DEV/cs-org-key.pem" ]; then
    node -e "const {generateKeyPairSync}=require('node:crypto');const {privateKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});require('node:fs').writeFileSync(process.argv[1],privateKey.export({type:'pkcs8',format:'pem'}))" "$DEV/cs-org-key.pem"
  fi
  start_cs_mock
  devvar CODESTORAGE_API_URL "http://127.0.0.1:$CS_MOCK_PORT"
  devvar CODESTORAGE_ORG_NAME "fragment-dev"
  devvar PIERRE_PRIVATE_KEY "$(cat "$DEV/cs-org-key.pem")"
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    devvar OPENROUTER_API_KEY "$OPENROUTER_API_KEY"
  fi
  # generation tools (ctx.image/ctx.video): fal.ai key + optional defaults
  if [ -n "${FAL_API_KEY:-}" ]; then
    devvar FAL_API_KEY "$FAL_API_KEY"
  fi
  if [ -n "${FRAGMENT_IMAGE_MODEL:-}" ]; then
    devvar FRAGMENT_IMAGE_MODEL "$FRAGMENT_IMAGE_MODEL"
  fi
  if [ -n "${FRAGMENT_VIDEO_MODEL:-}" ]; then
    devvar FRAGMENT_VIDEO_MODEL "$FRAGMENT_VIDEO_MODEL"
  fi
  # e2e fake lane: E2E_FAL_FAKE=1 starts a local stand-in fal queue and
  # points the runtime at it with a dummy key, so the gen pipeline gets
  # full coverage in CI without spending money (or a key)
  if [ -n "${E2E_FAL_FAKE:-}" ]; then
    start_fal_fake
    devvar FAL_API_KEY "${E2E_FAL_KEY:-e2e-fal-key-0123456789abcdef}"
    devvar FRAGMENT_FAL_BASE "http://127.0.0.1:$FAL_FAKE_PORT"
  fi
  if [ -n "${FRAGMENT_HOST_SECRET:-}" ]; then
    devvar FRAGMENT_HOST_SECRET "$FRAGMENT_HOST_SECRET"
  fi
  mv "$DEV_VARS.tmp" "$DEV_VARS"
}

start_celld() {
  if celld_running; then echo "celld dev: already running on :$CELLD_PORT"; return; fi
  # state lives under .dev (reached through a runtime/.celld symlink) so
  # `wipe` owns all of it in one place. NOTE: this does NOT quiet celld dev's
  # watcher on linux — inotify resolves the link and watches the target's
  # inodes, so state writes there still restart the worker (repro'd in a
  # container; see .github/workflows/ci.yml for why e2e runs on macOS).
  # macOS/FSEvents is path-rooted, so dev machines stay quiet either way.
  if [ -d runtime/.celld ] && [ ! -L runtime/.celld ]; then rm -rf runtime/.celld; fi
  mkdir -p "$DEV/celld-state"
  ln -sfn "../$DEV/celld-state" runtime/.celld
  celld_env
  # explicit sequencing: `cd runtime && nohup … & echo $!` backgrounds the
  # cd too, so the pid write ran from the repo root and landed in
  # <repo>/../.dev — a directory that happens to exist on dev machines and
  # never on CI runners (found by the first GitHub-hosted run)
  # CELLD_DEV_LOGS=1 turns on celld's own logging (watcher paths included) —
  # exists to diagnose host churn from CI artifacts
  (
    cd runtime
    nohup "${CELLD_BIN:-celld}" dev --port "$CELLD_PORT" ${CELLD_DEV_LOGS:+--logs} > "../$DEV/celld-dev.log" 2>&1 &
    echo $! > "../$DEV/celld-dev.pid"
  )
  for _ in $(seq 1 30); do celld_running && break; sleep 0.5; done
  celld_running || { echo "celld dev: did not come up; last log lines:" >&2; tail -20 "$DEV/celld-dev.log" >&2; exit 1; }
  echo "celld dev: started on :$CELLD_PORT (state via runtime/.celld → .dev/celld-state)"
}

stop_all() {
  for pidfile in "$DEV/celld-dev.pid" "$DEV/cs-mock.pid" "$DEV/fal-fake.pid"; do
    if [ -f "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
  done
  pkill -f "celld dev" 2>/dev/null || true
  # celld dev re-execs itself as `celld --no-control-plane --bucket celld-dev`
  pkill -f "celld.*--bucket celld-dev" 2>/dev/null || true
  # never trust the drain (the old ci-up lesson): force-kill the overstayers
  # or the next start hits EADDRINUSE
  for _ in $(seq 1 20); do
    pgrep -f "celld.*--bucket celld-dev" >/dev/null 2>&1 || break
    sleep 0.5
  done
  pkill -9 -f "celld.*--bucket celld-dev" 2>/dev/null || true
}

case "${1:-}" in
  up)
    tools
    ./scripts/build-runtime >/dev/null
    start_celld
    echo "fragment host: http://127.0.0.1:$CELLD_PORT (file plane: mock code.storage on :$CS_MOCK_PORT)"
    echo "  CLI:  fragment --host http://127.0.0.1:$CELLD_PORT …"
    ;;
  deploy)
    # celld dev runs the current runtime source; a deploy is just a rebuild
    ./scripts/build-runtime
    stop_all
    start_celld
    echo "deployed."
    ;;
  down)
    stop_all
    echo "down."
    ;;
  status)
    cs_mock_running && echo "cs-mock: up (http://127.0.0.1:$CS_MOCK_PORT)" || echo "cs-mock: down"
    celld_running && echo "celld dev: up (http://127.0.0.1:$CELLD_PORT)" || echo "celld dev: down"
    ;;
  logs)
    tail -30 "$DEV/celld-dev.log" 2>/dev/null
    ;;
  wipe)
    stop_all
    rm -rf "$DEV/celld-state" "$DEV/cs-mock-root" "$DEV/cs-org-key.pem" "$DEV/host-secret"
    echo "wiped: cell state, the mock file plane, and the dev keys discarded together"
    ;;
  *)
    echo "usage: scripts/dev up|down|deploy|status|logs|wipe" >&2
    exit 1
    ;;
esac
