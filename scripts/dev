#!/usr/bin/env bash
# fragment dev environment: celld dev (local object store) + blobsd (fs
# backend) — two native processes, no docker, no MinIO.
# verbs: up | down | deploy | status | logs | wipe
#
# Local world persists in .dev/celld-state (cells, via the runtime/.celld
# (blob tier). `wipe` throws both away together — a fresh tier behind old
# cell state means rows naming objects that don't exist, so they are born
# and destroyed as a pair.
set -euo pipefail
cd "$(dirname "$0")/.."
DEV=.dev
TOOLS="$DEV/tools"
CELLD_PORT=8789
BLOBSD_PORT=9940
FAL_FAKE_PORT=9942  # 9941 is taken by the e2e tier-lane stub
# Long enough for blobsd's 16-char token floor; the e2e hint below passes it
# to the suite via E2E_BLOBSD_TOKEN so dev stack and tests share one tier.
BLOBSD_TOKEN="${DEV_BLOBSD_TOKEN:-e2e-blob-token-0123456789abcdef}"

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
mkdir -p "$DEV"

# Optional project .env: OPENROUTER_API_KEY=..., FAL_API_KEY=... (never committed)
if [ -f .env ]; then set -a; . ./.env; set +a; fi
for keyfile in "$HOME/dev/finite/fragment/.env"; do
  if [ -z "${OPENROUTER_API_KEY:-}" ] && [ -f "$keyfile" ]; then
    OPENROUTER_API_KEY="$(grep -o '^OPENROUTER_API_KEY=.*' "$keyfile" | head -1 | cut -d= -f2-)"
    export OPENROUTER_API_KEY
  fi
done

tools() {
  # celld dev bundles the runtime with esbuild (CELLD_ESBUILD when not on PATH)
  if [ ! -x "$TOOLS/node_modules/.bin/esbuild" ]; then
    mkdir -p "$TOOLS"
    (cd "$TOOLS" && [ -f package.json ] || npm init -y >/dev/null; npm install esbuild >/dev/null)
  fi
}

celld_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$CELLD_PORT/__internal/ping"; }
blobsd_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$BLOBSD_PORT/"; }

start_blobsd() {
  if blobsd_running; then echo "blobsd: already running on :$BLOBSD_PORT"; return; fi
  if [ ! -x blobsd/target/release/blobsd ]; then
    echo "blobsd: building (first run)…"
    (cd blobsd && cargo build --release >/dev/null)
  fi
  mkdir -p "$DEV/blobsd" "$DEV/blobs-root"
  BLOBSD_LISTEN="127.0.0.1:$BLOBSD_PORT" \
  BLOBSD_DATA_DIR="$PWD/$DEV/blobsd" \
  BLOBSD_PUBLIC_URL="http://127.0.0.1:$BLOBSD_PORT" \
  BLOBSD_BACKEND=fs \
  BLOBSD_FS_ROOT="$PWD/$DEV/blobs-root" \
  BLOBSD_ALLOW_NPUBS='*' \
  BLOBSD_INTERNAL_TOKEN="$BLOBSD_TOKEN" \
  BLOBSD_PUBLIC_GET=true \
  nohup blobsd/target/release/blobsd > "$DEV/blobsd.log" 2>&1 &
  echo $! > "$DEV/blobsd.pid"
  for _ in $(seq 1 20); do blobsd_running && break; sleep 0.5; done
  blobsd_running || { echo "blobsd: did not come up; last log lines:" >&2; tail -10 "$DEV/blobsd.log" >&2; exit 1; }
  echo "blobsd: started on :$BLOBSD_PORT (fs backend, $DEV/blobs-root)"
}

start_fal_fake() {
  fal_fake_running() { curl -s -o /dev/null -m 2 "http://127.0.0.1:$FAL_FAKE_PORT/health"; }
  if fal_fake_running; then echo "fal-fake: already running on :$FAL_FAKE_PORT"; return; fi
  nohup node scripts/fal-fake.mjs "$FAL_FAKE_PORT" > "$DEV/fal-fake.log" 2>&1 &
  echo $! > "$DEV/fal-fake.pid"
  for _ in $(seq 1 20); do fal_fake_running && break; sleep 0.5; done
  fal_fake_running || { echo "fal-fake: did not come up; last log lines:" >&2; tail -10 "$DEV/fal-fake.log" >&2; exit 1; }
  echo "fal-fake: started on :$FAL_FAKE_PORT (stand-in fal queue for e2e)"
}

celld_env() {
  export CELLD_WORKER_LOADER=LOADER
  export CELLD_VAR_FRAGMENT_INTERNAL_URL="http://127.0.0.1:$CELLD_PORT"
  export CELLD_ESBUILD="$PWD/$TOOLS/node_modules/.bin/esbuild"
  export CELLD_VAR_BLOBSD_URL="http://127.0.0.1:$BLOBSD_PORT"
  export CELLD_VAR_BLOBSD_INTERNAL_TOKEN="$BLOBSD_TOKEN"
  export CELLD_VAR_BLOBSD_PUBLIC_URL="http://127.0.0.1:$BLOBSD_PORT"
  export CELLD_VAR_BLOBSD_PUBLIC_GET="1"
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    export CELLD_VAR_OPENROUTER_API_KEY="$OPENROUTER_API_KEY"
  fi
  # generation tools (ctx.image/ctx.video): fal.ai key + optional defaults
  if [ -n "${FAL_API_KEY:-}" ]; then
    export CELLD_VAR_FAL_API_KEY="$FAL_API_KEY"
  fi
  if [ -n "${FRAGMENT_IMAGE_MODEL:-}" ]; then
    export CELLD_VAR_FRAGMENT_IMAGE_MODEL="$FRAGMENT_IMAGE_MODEL"
  fi
  if [ -n "${FRAGMENT_VIDEO_MODEL:-}" ]; then
    export CELLD_VAR_FRAGMENT_VIDEO_MODEL="$FRAGMENT_VIDEO_MODEL"
  fi
  # e2e fake lane: E2E_FAL_FAKE=1 starts a local stand-in fal queue and
  # points the runtime at it with a dummy key, so the gen pipeline gets
  # full coverage in CI without spending money (or a key)
  if [ -n "${E2E_FAL_FAKE:-}" ]; then
    start_fal_fake
    export CELLD_VAR_FAL_API_KEY="${E2E_FAL_KEY:-e2e-fal-key-0123456789abcdef}"
    export CELLD_VAR_FRAGMENT_FAL_BASE="http://127.0.0.1:$FAL_FAKE_PORT"
  fi
  if [ -n "${FRAGMENT_HOST_SECRET:-}" ]; then
    export CELLD_VAR_FRAGMENT_HOST_SECRET="$FRAGMENT_HOST_SECRET"
  fi
}

start_celld() {
  if celld_running; then echo "celld dev: already running on :$CELLD_PORT"; return; fi
  # state lives under .dev (reached through a runtime/.celld symlink) so
  # `wipe` owns all of it in one place. NOTE: this does NOT quiet celld dev's
  # watcher on linux — inotify resolves the link and watches the target's
  # inodes, so state writes there still restart the worker (repro'd in a
  # container; see .github/workflows/ci.yml for why e2e runs on macOS).
  # macOS/FSEvents is path-rooted, so dev machines stay quiet either way.
  if [ -d runtime/.celld ] && [ ! -L runtime/.celld ]; then rm -rf runtime/.celld; fi
  mkdir -p "$DEV/celld-state"
  ln -sfn "../$DEV/celld-state" runtime/.celld
  celld_env
  # explicit sequencing: `cd runtime && nohup … & echo $!` backgrounds the
  # cd too, so the pid write ran from the repo root and landed in
  # <repo>/../.dev — a directory that happens to exist on dev machines and
  # never on CI runners (found by the first GitHub-hosted run)
  # CELLD_DEV_LOGS=1 turns on celld's own logging (watcher paths included) —
  # exists to diagnose host churn from CI artifacts
  (
    cd runtime
    nohup celld dev --port "$CELLD_PORT" ${CELLD_DEV_LOGS:+--logs} > "../$DEV/celld-dev.log" 2>&1 &
    echo $! > "../$DEV/celld-dev.pid"
  )
  for _ in $(seq 1 30); do celld_running && break; sleep 0.5; done
  celld_running || { echo "celld dev: did not come up; last log lines:" >&2; tail -20 "$DEV/celld-dev.log" >&2; exit 1; }
  echo "celld dev: started on :$CELLD_PORT (state via runtime/.celld → .dev/celld-state)"
}

stop_all() {
  for pidfile in "$DEV/celld-dev.pid" "$DEV/blobsd.pid" "$DEV/fal-fake.pid"; do
    if [ -f "$pidfile" ]; then
      kill "$(cat "$pidfile")" 2>/dev/null || true
      rm -f "$pidfile"
    fi
  done
  pkill -f "celld dev" 2>/dev/null || true
  # celld dev re-execs itself as `celld --no-control-plane --bucket celld-dev`
  pkill -f "celld.*--bucket celld-dev" 2>/dev/null || true
  pkill -f "blobsd/target/release/blobsd" 2>/dev/null || true
  # never trust the drain (the old ci-up lesson): force-kill the overstayers
  # or the next start hits EADDRINUSE
  for _ in $(seq 1 20); do
    pgrep -f "celld.*--bucket celld-dev" >/dev/null 2>&1 || break
    sleep 0.5
  done
  pkill -9 -f "celld.*--bucket celld-dev" 2>/dev/null || true
}

case "${1:-}" in
  up)
    tools
    ./scripts/build-runtime >/dev/null
    start_blobsd
    start_celld
    echo "fragment host: http://127.0.0.1:$CELLD_PORT"
    echo "  CLI:  fragment --host http://127.0.0.1:$CELLD_PORT …"
    echo "  e2e:  E2E_BLOBSD_TOKEN=$BLOBSD_TOKEN FRAGMENT_BLOB_URL=http://127.0.0.1:$BLOBSD_PORT node scripts/e2e.mjs --all"
    ;;
  deploy)
    # celld dev runs the current runtime source; a deploy is just a rebuild
    ./scripts/build-runtime
    stop_all
    start_blobsd
    start_celld
    echo "deployed."
    ;;
  down)
    stop_all
    echo "down."
    ;;
  status)
    blobsd_running && echo "blobsd: up (http://127.0.0.1:$BLOBSD_PORT)" || echo "blobsd: down"
    celld_running && echo "celld dev: up (http://127.0.0.1:$CELLD_PORT)" || echo "celld dev: down"
    ;;
  logs)
    tail -30 "$DEV/celld-dev.log" 2>/dev/null
    ;;
  wipe)
    stop_all
    rm -rf "$DEV/celld-state" "$DEV/blobsd" "$DEV/blobs-root"
    echo "wiped: cell state and blob tier discarded together"
    ;;
  *)
    echo "usage: scripts/dev up|down|deploy|status|logs|wipe" >&2
    exit 1
    ;;
esac
