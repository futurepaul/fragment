{
  "name": "pet",
  "computer": { "start": "node computer/pet.mjs" },
  "operations": {
    "frame": {
      "kind": "mutation",
      "role": "editor",
      "ephemeral": true,
      "input": {
        "type": "object",
        "required": ["jpeg", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "jpeg": { "type": "string", "minLength": 4, "maxLength": 180000, "description": "the screen, as a base64 JPEG" },
          "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "title": { "type": "string", "maxLength": 300, "description": "what is on screen: its window's title" },
          "driver": { "type": "string", "maxLength": 100, "description": "who poked it last" }
        }
      }
    },
    "screen": { "kind": "query", "role": "viewer", "input": { "type": "object", "additionalProperties": false } },
    "run": {
      "kind": "job",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": false,
        "properties": { "command": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "a bash command, run on the computer in ~/fragment" } }
      }
    }
  },
  "channels": { "control": { "read": "viewer", "post": "viewer", "signedIn": true } },
  "meta": { "title": "Pet", "description": "A computer everyone here shares: its screen live, driven together. It is awake while someone has it open, on your budget." }
}
