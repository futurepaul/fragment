{
  "name": "pet",
  "computer": { "start": "node computer/pet.mjs" },
  "operations": {
    "frame": {
      "kind": "mutation",
      "role": "editor",
      "ephemeral": true,
      "input": {
        "type": "object",
        "required": ["shot", "size", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "shot": { "type": "string", "minLength": 64, "maxLength": 64, "description": "the screen: the sha256 of a JPEG blob of this fragment's, which pages show at __blob/<shot>" },
          "size": { "type": "integer", "minimum": 1, "description": "its bytes" },
          "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "title": { "type": "string", "maxLength": 300, "description": "what is on screen: its window's title" },
          "driver": { "type": "string", "maxLength": 100, "description": "who poked it last" }
        }
      }
    },
    "screen": { "kind": "query", "role": "viewer", "input": { "type": "object", "additionalProperties": false } },
    "run": {
      "kind": "job",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": false,
        "properties": { "command": { "type": "string", "minLength": 1, "maxLength": 8000, "description": "a bash command, run on the computer in ~/fragment" } }
      }
    },
    "do": {
      "kind": "job",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["task"],
        "additionalProperties": false,
        "properties": {
          "task": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "what the pet's agent does on its screen" },
          "chat": { "type": "string", "maxLength": 200, "description": "the chat that asked (<fragment>/<channel>): its session here, and where the steps go" }
        }
      }
    }
  },
  "channels": {
    "control": { "read": "viewer", "post": "viewer", "signedIn": true },
    "work": { "read": "viewer", "post": "editor" }
  },
  "meta": { "title": "Pet", "description": "A computer everyone here shares: its screen live, driven together and by its agent. It is awake while someone has it open, on your budget." }
}
