{
  "name": "builder",
  "computer": {},
  "operations": {
    "build": {
      "kind": "job",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["task"],
        "additionalProperties": false,
        "properties": {
          "task": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "chat": { "type": "string", "maxLength": 200, "description": "the chat that asked (<fragment>/<channel>): its session here, and where the steps go" },
          "fragments": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 127 }, "description": "the owner's fragments to change instead of making a new one (this computer is made an editor of each)" }
        }
      }
    },
    "record": {
      "kind": "mutation",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["run", "task", "status"],
        "additionalProperties": false,
        "properties": {
          "run": { "type": "integer", "minimum": 1 },
          "task": { "type": "string", "maxLength": 4000 },
          "status": { "enum": ["installing", "building", "built", "failed"] },
          "built": { "type": "array", "maxItems": 20 },
          "message": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "builds": { "kind": "query", "role": "viewer", "input": { "type": "object", "additionalProperties": false } }
  },
  "channels": { "work": { "read": "viewer", "post": "editor" } },
  "meta": { "title": "Builder", "description": "Say what to build: goose, on this fragment's own computer, makes it as a new fragment and deploys it." }
}
