{
  "kind": "mind",
  "operations": {
    "view": {
      "kind": "query",
      "description": "Your memory of every chat, as the mind's agent sees it: the whole chat, oldest first, as one-line summaries inside <chat> tags. Each line is id+n|text, the n messages from id on, summarized; recent lines cover one message each, older ones more. Read it first, then zoom a line to open it, or search for words.",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "upto": { "type": "integer", "minimum": 0, "description": "only the lines that start before this message" } }
      }
    },
    "zoom": {
      "kind": "query",
      "description": "Open the line id+n of the view into the two lines of n/2 under it; n = 1 gives the message whole.",
      "input": {
        "type": "object",
        "required": ["id", "n"],
        "additionalProperties": false,
        "properties": { "id": { "type": "integer", "minimum": 0 }, "n": { "type": "integer", "minimum": 1 } }
      }
    },
    "date": {
      "kind": "query",
      "description": "The date and time of message id.",
      "input": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "integer", "minimum": 0 } } }
    },
    "search": {
      "kind": "query",
      "description": "Search every message of every chat for words, newest first: {results: [{i, kind, thread, at, snippet}]}. zoom(i, 1) opens a hit whole.",
      "input": {
        "type": "object",
        "required": ["q"],
        "additionalProperties": false,
        "properties": {
          "q": { "type": "string", "minLength": 1, "maxLength": 256 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 },
          "thread": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "note": {
      "kind": "mutation",
      "description": "Add a note to the memory: something worth remembering, in plain words. It joins the memory as every message does, and every chat sees it from then on.",
      "input": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 30000 } }
      }
    },
    "threads": {
      "kind": "query",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "minLength": 1, "maxLength": 64 },
          "before": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    },
    "thread": {
      "kind": "query",
      "input": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "before": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      }
    },
    "context": {
      "kind": "query",
      "input": {
        "type": "object",
        "required": ["i"],
        "additionalProperties": false,
        "properties": {
          "i": { "type": "integer", "minimum": 0 },
          "before": { "type": "integer", "minimum": 0, "maximum": 50 },
          "after": { "type": "integer", "minimum": 0, "maximum": 50 }
        }
      }
    },
    "export": {
      "kind": "query",
      "role": "editor",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "after": { "type": "integer", "minimum": 0 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 2000 }
        }
      }
    },
    "memory": { "kind": "query", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "node": {
      "kind": "query",
      "input": {
        "type": "object",
        "required": ["id", "n"],
        "additionalProperties": false,
        "properties": { "id": { "type": "integer", "minimum": 0 }, "n": { "type": "integer", "minimum": 1 } }
      }
    },
    "topics": { "kind": "query", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "personas": { "kind": "query", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "tasks": {
      "kind": "query",
      "input": { "type": "object", "additionalProperties": false, "properties": { "thread": { "type": "string", "minLength": 1, "maxLength": 64 } } }
    },
    "status": { "kind": "query", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "settings": { "kind": "query", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "topic_add": {
      "kind": "mutation",
      "input": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "description": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "topic_remove": {
      "kind": "mutation",
      "input": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 64 } } }
    },
    "persona_set": {
      "kind": "mutation",
      "input": {
        "type": "object",
        "required": ["name", "emoji", "instructions", "hands"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 },
          "emoji": { "type": "string", "maxLength": 16 },
          "instructions": { "type": "string", "maxLength": 4000 },
          "hands": { "type": "boolean" }
        }
      }
    },
    "persona_remove": {
      "kind": "mutation",
      "input": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 32 } } }
    },
    "persona_default": {
      "kind": "mutation",
      "input": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 32 } } }
    },
    "settings_set": {
      "kind": "mutation",
      "input": { "type": "object", "required": ["about"], "additionalProperties": false, "properties": { "about": { "type": "string", "maxLength": 8000 } } }
    },
    "stop": {
      "kind": "mutation",
      "input": { "type": "object", "required": ["thread"], "additionalProperties": false, "properties": { "thread": { "type": "string", "minLength": 1, "maxLength": 64 } } }
    },
    "topic_suggest": { "kind": "job", "input": { "type": "object", "additionalProperties": false, "properties": {} } },
    "import": {
      "kind": "mutation",
      "input": {
        "type": "object",
        "required": ["source", "conversation", "messages"],
        "additionalProperties": false,
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 32 },
          "conversation": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "title": { "type": ["string", "null"], "maxLength": 200 },
              "started": { "type": ["integer", "null"], "minimum": 0 }
            }
          },
          "from": { "type": "integer", "minimum": 0 },
          "total": { "type": ["integer", "null"], "minimum": 0 },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["role", "text", "at"],
              "additionalProperties": false,
              "properties": {
                "role": { "enum": ["user", "assistant"] },
                "text": { "type": "string", "minLength": 1, "maxLength": 30000 },
                "at": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "imported": {
      "kind": "query",
      "input": {
        "type": "object",
        "required": ["conversations"],
        "additionalProperties": false,
        "properties": {
          "conversations": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["source", "id"],
              "additionalProperties": false,
              "properties": { "source": { "type": "string", "maxLength": 32 }, "id": { "type": "string", "maxLength": 200 } }
            }
          }
        }
      }
    },

    "heard": { "kind": "job" },
    "pump": { "kind": "job" },
    "classify": { "kind": "job" },
    "hands_said": { "kind": "job" },
    "hear": { "kind": "mutation" },
    "turn_begin": { "kind": "mutation" },
    "turn_touch": { "kind": "mutation" },
    "turn_end": { "kind": "mutation" },
    "logged": { "kind": "mutation" },
    "pump_plan": { "kind": "query", "role": "editor" },
    "node_built": { "kind": "mutation" },
    "nodes_built": { "kind": "mutation" },
    "task_open": { "kind": "mutation" },
    "hands_reply": { "kind": "mutation" },
    "topics_set": { "kind": "mutation" }
  },
  "channels": {
    "say": { "read": "editor", "post": "editor", "signedIn": true },
    "log": { "read": "editor" },
    "chat": { "read": "editor", "post": "editor" },
    "work": { "read": "editor", "post": "editor" },
    "sort": { "read": "editor" },
    "compact": { "read": "editor" }
  },
  "triggers": [
    { "channel": "say", "from": "person", "run": "heard" },
    { "channel": "chat", "from": "agent", "run": "hands_said" },
    { "channel": "sort", "run": "classify" },
    { "channel": "compact", "run": "pump" }
  ],
  "storage": { "maxBytes": 1073741824 },
  "capabilities": ["owner"],
  "meta": {
    "title": "Mind",
    "description": "One memory for every chat: say anything, start fresh whenever you like, and it remembers it all, sorts it into topics, and hands computer work to your agent."
  }
}
