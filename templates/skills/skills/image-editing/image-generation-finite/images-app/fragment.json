{
  "operations": {
    "draw": {
      "kind": "job",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["prompt", "path"],
        "additionalProperties": false,
        "properties": {
          "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "path": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9._-]{0,120}\\.jpe?g$" },
          "steps": { "type": "integer", "minimum": 1, "maximum": 8 }
        }
      }
    }
  },
  "meta": { "title": "Images", "description": "Images drawn for you: each one a JPEG under images/." }
}
