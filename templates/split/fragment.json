{
  "name": "split",
  "operations": {
    "about": {
      "kind": "mutation",
      "role": "editor",
      "input": {
        "type": "object",
        "required": ["title", "currency"],
        "additionalProperties": false,
        "properties": { "title": { "type": "string", "minLength": 1, "maxLength": 80 }, "currency": { "type": "string", "minLength": 3, "maxLength": 3 } }
      }
    },
    "join": {
      "kind": "mutation",
      "role": "viewer",
      "input": { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 40 } } }
    },
    "add": {
      "kind": "mutation",
      "role": "viewer",
      "input": {
        "type": "object",
        "required": ["what", "cents"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string", "minLength": 1, "maxLength": 120 },
          "cents": { "type": "integer", "minimum": 1, "maximum": 100000000 },
          "paidBy": { "type": "string", "maxLength": 64 },
          "among": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
          "lines": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "required": ["name", "cents"],
              "additionalProperties": false,
              "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "cents": { "type": "integer", "minimum": 0, "maximum": 100000000 } }
            }
          }
        }
      }
    },
    "settle": {
      "kind": "mutation",
      "role": "viewer",
      "input": {
        "type": "object",
        "required": ["to", "cents"],
        "additionalProperties": false,
        "properties": { "to": { "type": "string", "maxLength": 64 }, "cents": { "type": "integer", "minimum": 1, "maximum": 100000000 } }
      }
    },
    "remove": {
      "kind": "mutation",
      "role": "viewer",
      "input": { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "type": "integer", "minimum": 1 } } }
    },
    "scan": {
      "kind": "job",
      "role": "viewer",
      "input": { "type": "object", "required": ["image"], "additionalProperties": false, "properties": { "image": { "type": "string", "minLength": 1, "maxLength": 240000 } } }
    },
    "ledger": { "kind": "query", "role": "viewer", "input": { "type": "object", "additionalProperties": false } }
  },
  "channels": { "scans": { "read": "viewer" } },
  "meta": { "title": "Split", "description": "Shared costs for a trip or a house: snap a receipt, and everyone sees who owes whom, live." }
}
