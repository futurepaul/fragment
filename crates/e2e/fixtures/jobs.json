{
  "operations": {
    "save": {
      "kind": "mutation",
      "input": {
        "type": "object",
        "required": ["texts", "source"],
        "properties": { "texts": { "type": "array", "items": { "type": "string" }, "maxItems": 100 }, "source": { "type": "string" } }
      }
    },
    "items": { "kind": "query" },
    "digest": { "kind": "job", "input": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" } } } },
    "ingest": { "kind": "job" },
    "set_flag": { "kind": "mutation" },
    "flag": { "kind": "query" },
    "fragile": { "kind": "job" },
    "nap": { "kind": "job" },
    "careful": { "kind": "job" },
    "probe": { "kind": "job" },
    "parent": { "kind": "job" },
    "wrong": { "kind": "job" },
    "ping": { "kind": "mutation" },
    "raise": { "kind": "mutation" },
    "boom": { "kind": "job" },
    "tick": { "kind": "mutation" },
    "ticks": { "kind": "query" }
  },
  "channels": { "feed": { "read": "viewer" }, "loop": {}, "alarms": {} },
  "triggers": [
    { "channel": "inbox", "run": "ingest" },
    { "channel": "loop", "run": "ping" },
    { "channel": "alarms", "run": "boom" },
    { "files": "notes/**", "run": "tick" }
  ]
}
