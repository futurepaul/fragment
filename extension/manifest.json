{
  "manifest_version": 3,
  "name": "Fragment",
  "version": "0.1.0",
  "description": "Lets your agents use this browser: only the tabs they open, those and the tabs you choose, or all of it, as you set.",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*.fragment.localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "platform.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Fragment",
    "default_popup": "popup.html"
  }
}
