# /etc/systemd/system/celld.service
# One celld node = one fragment fleet. Single-node fleet for now; add peers
# later with --internal-listen/--advertise on a private network.
#
# All host-specific values (bucket, endpoint, credentials) live in
# /etc/celld.env — see deploy/env.example. Never in this repo.

[Unit]
Description=celld — fragment host fleet node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=celld
Group=celld
EnvironmentFile=/etc/celld.env
Environment=CELLD_WATCH=/var/lib/celld/watch
Environment=CELLD_WORKER_LOADER=LOADER
Environment=CELLD_VAR_FRAGMENT_INTERNAL_URL=http://127.0.0.1:8080
Environment=CELLD_VAR_FRAGMENT_SUBDOMAIN_HOST=fragment.club
ExecStart=/usr/local/bin/celld \
  --bucket ${CELLD_BUCKET} \
  --endpoint ${S3_ENDPOINT} \
  --listen 127.0.0.1:8080 \
  --internal-listen 127.0.0.1:8081 \
  --advertise 127.0.0.1:8081
StateDirectory=celld
Restart=always
RestartSec=2
# graceful drain: celld default is 25s; give it headroom before the kill
TimeoutStopSec=35
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
