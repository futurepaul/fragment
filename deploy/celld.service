# /etc/systemd/system/celld.service
# One celld node = one fragment fleet. Single-node fleet for now; add peers
# later with --internal-listen/--advertise on a private network.
#
# Secrets (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) live in /etc/celld.env,
# mode 0600 root:root — never in this repo.

[Unit]
Description=celld — fragment host fleet node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=celld
Group=celld
EnvironmentFile=/etc/celld.env
Environment=CELLD_WATCH=/var/lib/celld/watch
Environment=CELLD_WORKER_LOADER=LOADER
Environment=CELLD_VAR_FRAGMENT_INTERNAL_URL=http://127.0.0.1:8080
ExecStart=/usr/local/bin/celld \
  --bucket s3://BUCKET_NAME \
  --endpoint ENDPOINT_URL \
  --listen 127.0.0.1:8080
StateDirectory=celld
Restart=always
RestartSec=2
# graceful drain: celld default is 25s; give it headroom before RestartForce
TimeoutStopSec=35
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
