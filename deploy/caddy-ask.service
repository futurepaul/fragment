# /etc/systemd/system/caddy-ask.service — gates Caddy on-demand TLS
# issuance to *.fragment.club (see deploy/Caddyfile).
[Unit]
Description=Caddy on-demand TLS ask gate
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/caddy-ask
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
