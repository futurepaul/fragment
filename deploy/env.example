# Copy to /etc/celld.env on the VPS and fill in. chmod 600, root:root.
# These are the Latitude object-storage credentials (project access key or
# per-bucket key). They grant full control of the fleet bucket — treat like
# a production database password.

AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# celld reads region for sigv4 signing. Latitude doesn't document one; if
# requests fail signature/region checks, try your bucket's site (e.g. nyc).
AWS_REGION=us-east-1
