# Copy to /etc/celld.env on the VPS and fill in. chmod 600, root:root.
# These grant full control of the fleet bucket — treat like a production
# database password.

# Latitude object storage credentials (project access key or per-bucket key)
AWS_ACCESS_KEY_ID=PASTE
AWS_SECRET_ACCESS_KEY=PASTE

# The fleet bucket and its S3 endpoint. Standard-class Latitude endpoint is
# https://<account-id>.s3.latitude.sh (account ID is in the Object storage
# sidebar); high-performance is https://objects.<region>.storage.sh.
CELLD_BUCKET=s3://YOUR-BUCKET-NAME
S3_ENDPOINT=https://ACCOUNT-ID.s3.latitude.sh

# sigv4 signing region. Latitude doesn't document one; if requests fail
# signature/region checks, try your bucket's site (e.g. nyc).
AWS_REGION=us-east-1

# Shared secret for the runtime-internal /__internal plane (ctx loopback from
# workflow/app isolates). Generate with: openssl rand -hex 32. Without it the
# plane is still gated per-cell by run tokens and registry/init are blocked;
# with it, a caller must also carry x-fragment-host-secret.
FRAGMENT_HOST_SECRET=

# fal.ai key for the generation tools (ctx.image / ctx.video / the gen
# template). The CELLD_VAR_ prefix is how env crosses into worker env —
# same ride as OPENROUTER_API_KEY for ctx.ai. Optional default overrides:
#   CELLD_VAR_FRAGMENT_IMAGE_MODEL=fal-ai/flux-2
#   CELLD_VAR_FRAGMENT_VIDEO_MODEL=minimax/h3-max/text-to-video
CELLD_VAR_FAL_API_KEY=
