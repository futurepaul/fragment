// A deployment's configuration for `cargo xtask deploy --config <file>`
// (xtask/src/deploy.rs). Keep yours outside the repo: it names your
// account. Every secret the Workers read lives in the account's Cloudflare
// Secrets Store and is named here by its store name, never a value
// (docs/secrets.md): `cargo xtask secret set <name> --config <file>` sets
// one, `secret gen <name>` makes a host secret, `secret list` shows them.
// A deploy checks the store holds every one named here before it changes
// anything.
//
// CI deploys (.github/workflows/ci.yml, `deploy`: master's green push to
// its preview, production's to production) from this file, held whole in
// its GitHub environment's secret DEPLOY_CONFIG, in base64 (`base64 -w0 <
// <file> | gh secret set DEPLOY_CONFIG --env <environment>`; never read
// back, so keep the file). There, `dns_token_file` and `test_secret_file`
// are the paths the job writes them to, below, and every computer image
// is pinned by digest (`--pinned-only`).
{
  // Your Cloudflare account (`wrangler whoami`), and a branch deployment's
  // zone: `--branch <b>` deploys at <b>.<zone>, its fragments at
  // <name>--<b>.<zone>, both routes in the zone. The zone needs one proxied
  // wildcard DNS record (`*` AAAA 100::), which Universal SSL covers.
  // wrangler deploys with CLOUDFLARE_API_TOKEN: a token on this account and
  // the zone (or both of a deployment of its own's, below) with Account ·
  // Workers Scripts, Workers R2 Storage, Workflows, Queues, Containers,
  // Browser Rendering and AI Gateway · Edit; Workers KV Storage, Account
  // Settings and Secrets Store · Read; Zone · Workers Routes and DNS · Edit;
  // User · Memberships and User Details · Read (`wrangler delete`, in a
  // teardown, reads the account's KV namespaces).
  "account_id": "0123456789abcdef0123456789abcdef",
  "zone": "example.dev",
  // A Cloudflare API token with Zone · DNS · Edit on the zone (or both):
  // with it, a deploy makes the records its routes need when they are
  // missing. Without it, make them by hand. A file: it is the deploying
  // machine's own, which no Worker reads. CI's job writes its environment's
  // CLOUDFLARE_API_TOKEN to ~/.config/fragment/secrets/cloudflare-api-token:
  // a config CI deploys from names that.
  // "dns_token_file": "~/.config/fragment/secrets/cloudflare-dns-token",
  // A deployment of its own names its hosts instead of a zone (a `zone`
  // beside them is refused), each a zone's own name on the account: the
  // platform's route `<platform_host>/*` is in its zone, with a proxied
  // record at its apex, and the fragments' `*.<fragment_suffix>/*` in the
  // suffix's, with the wildcard record above (the bare suffix has neither).
  // One zone for both names it twice. It takes no --branch.
  // "platform_host": "finite.chat",
  // "fragment_suffix": "finite.place",
  // 32 random bytes or more, as text (`cargo xtask secret gen`): seals
  // every value at rest. Never set again in place: rotate it by name, the
  // new one here and the one before as host_secret_previous, until every
  // value is resealed (docs/secrets.md, Rotating the host secret).
  "host_secret": "fragment-host-secret",
  // "host_secret_previous": "fragment-host-secret-2026-09",
  // Every fragment's git. The org's signing key, in PEM.
  "codestorage": {
    "org": "your-org",
    "private_key": "fragment-codestorage-private-key"
  },
  // Sign-in: a WorkOS environment with AuthKit on, its redirect URI
  // https://<platform>/auth/callback.
  "workos": {
    "client_id": "fragment-workos-client-id",
    "api_key": "fragment-workos-api-key"
  },
  // What Stripe sells (docs/billing.md): the $200 always-on seat and the
  // $25 credit pack, their Prices found by lookup key
  // (`fragment_seat_always_on_month`, `fragment_credit_pack`; `cargo xtask
  // stripe setup` makes them). Leave it out and seats are
  // comped by operators only. The key is a restricted key of the account's
  // (Customers, Checkout Sessions, Subscriptions and portal sessions
  // written; Products and Prices read); the webhook secret is this
  // deployment's own endpoint's, which takes exactly
  // `fragment_core::stripe::EVENTS`. `portal` is the deployment's own
  // portal configuration, never the account's default (finite-mono's).
  // `key_file` is the same key in a file of this machine's (as the DNS
  // token is), for xtask's own calls: `cargo xtask stripe check|setup`,
  // and a branch's own endpoint at each deploy (decision 58).
  // "stripe": {
  //   "key": "fragment-stripe-key",
  //   "webhook_secret": "fragment-stripe-webhook-secret",
  //   "portal": "bpc_...",
  //   "tax": true,
  //   "key_file": "~/.config/fragment/secrets/stripe-restricted-key"
  // },
  // The AI Gateway the model route and image steps call through: one of
  // your own, named (never "default", which makes one that logs), with
  // Unified Billing, zero data retention on and its logs off. Without it,
  // Workers AI's models and images are off.
  // "ai_gateway": "fragment",
  // Where each of the model route's names runs (docs/computers.md,
  // Models): the tiers (`cheap`, every agent's default, and `medium`),
  // `fallback` (a tier's call is made on it once more when its own fails
  // before answering: not reached, 429 or a 5xx; and Hermes' own switch
  // when a call stalls) and `vision` (a runtime's calls about an image:
  // Hermes' computer_use screenshots). Each is a Workers AI model through
  // the gateway, `{"provider": "workers_ai", "model": <catalog id>}`, or a
  // model on an OpenAI-compatible API, `{"provider": "openai", "base_url",
  // "key": <its secret's name in the store>, "model": <its id there>,
  // "body"?: {…}}`. `body` is fields of that API's own that every call to it
  // carries, over the agent's of the same names: at most 4 KiB of JSON,
  // naming none of the fields the route writes (model, messages, stream,
  // stream_options, tools, tool_choice, max_tokens, max_completion_tokens,
  // reasoning_effort). A slot left out is on Workers AI: cheap GLM-5.3
  // Flash, medium GLM-5.3, fallback DeepSeek V4 Flash, vision GLM-5.3 Flash.
  // Every model is one the price book prices (fragment_core::price), or the
  // deploy is refused. Leave `models` out (as a preview without a key does)
  // and every tier runs on Workers AI.
  //
  // Finite's own (Paul, 2026-10-15; decision 61): its tiers on GLM-5.3 Flash
  // through OpenRouter, on one platform key, routed by `body` (OpenRouter's
  // provider routing, openrouter.ai/docs/guides/routing/provider-selection):
  // only zero-data-retention endpoints, the fastest first, each taking every
  // parameter the call sends, at fp8 or bf16, at most $0.15 a million
  // tokens in and $0.50 out (the price book charges that ceiling: raise one
  // and the other together); Workers AI's GLM-5.3 Flash behind them and for
  // images.
  "models": {
    "cheap": { "provider": "openai", "base_url": "https://openrouter.ai/api/v1",
               "key": "fragment-openrouter-key", "model": "z-ai/glm-5.3-flash",
               "body": { "provider": { "zdr": true, "sort": "throughput", "require_parameters": true,
                                       "quantizations": ["fp8", "bf16"],
                                       "max_price": { "prompt": 0.15, "completion": 0.5 } } } },
    "medium": { "provider": "openai", "base_url": "https://openrouter.ai/api/v1",
                "key": "fragment-openrouter-key", "model": "z-ai/glm-5.3-flash",
                "body": { "provider": { "zdr": true, "sort": "throughput", "require_parameters": true,
                                        "quantizations": ["fp8", "bf16"],
                                        "max_price": { "prompt": 0.15, "completion": 0.5 } } } },
    "fallback": { "provider": "workers_ai", "model": "@cf/zai-org/glm-5.3-flash" },
    "vision": { "provider": "workers_ai", "model": "@cf/zai-org/glm-5.3-flash" }
  },
  // Or its tiers on Finite Private, Finite's GLM-5.3 Flash on Tinfoil (its
  // key, `fpk_live_…`, issued by finite.computer; decision 61, 2026-10-14):
  // "models": {
  //   "cheap": { "provider": "openai", "base_url": "https://finite-private.finite.containers.tinfoil.dev/v1",
  //              "key": "fragment-finite-private-key", "model": "glm-5-3-flash" },
  //   "medium": { "provider": "openai", "base_url": "https://finite-private.finite.containers.tinfoil.dev/v1",
  //               "key": "fragment-finite-private-key", "model": "glm-5-3-flash" },
  //   "fallback": { "provider": "workers_ai", "model": "@cf/zai-org/glm-5.3-flash" },
  //   "vision": { "provider": "workers_ai", "model": "@cf/zai-org/glm-5.3-flash" }
  // },
  // A new person's plan: guest (the default), seat, or seat_always_on.
  // "default_plan": "guest",
  // Where a person whose computer will not start gets help: an https page
  // or a mailto address, linked from the shell's notice. Without it, the
  // shell shows them what to tell whoever runs the deployment.
  // "support_url": "mailto:help@example.dev",
  // The sender the platform's mail (invites, seats) comes from: a bare
  // address or an unquoted Name <address> (no comments or lists), on a
  // domain onboarded to Cloudflare Email Sending (`wrangler email sending
  // enable <domain>`). Without it, the deployment sends no mail.
  // "mail_from": "Finite.Computer <mail@finite.place>",
  // The operators (npubs or identities): they grant credit, set plans,
  // release usernames, and wipe a person (docs/api.md, Operators). Wipe
  // with an operator key no person holds (`fragment operator key <file>`
  // makes one and prints the npub to list here).
  "operators": [],
  // Computers (docs/computers.md): the images they run, by name, and the
  // one a new computer is pinned to. Without this the deployment makes no
  // computers. Each is built from the tree at every deploy (its Dockerfile
  // and build context, relative to the repo: the Hermes image builds from
  // the repo's root, as it carries the fragment CLI), or kept at a digest
  // this account's registry holds. Stable and canary (docs/computers.md):
  // the default kept at the digest a canary proved, the canary built.
  //   "hermes": { "image": "registry.cloudflare.com/<account_id>/<repository>@sha256:<64 hex>" },
  //   "hermes-canary": { "dockerfile": "images/hermes/Dockerfile", "build_context": "." }
  // Never drop a name while computers are pinned to it.
  "computers": {
    "default_image": "hermes",
    "images": {
      "hermes": { "dockerfile": "images/hermes/Dockerfile", "build_context": "." }
    }
    // no size: a computer starts at decision 13's 2 vCPU and 6 GiB
  },
  // The provider catalog a computer's swap offers (docs/computers.md,
  // "Connections and operator keys"): one row each, its kind, the hosts its
  // credential is sent to, where on a request it goes (a header and its
  // format, a query parameter, or a half of basic auth), and the
  // environment variables a guest finds its placeholder in, the names the
  // vendor's own SDK reads. A connection is a WorkOS Pipes provider,
  // enabled in the WorkOS environment above. An operator key's value is a
  // store secret, named as its `key`, as every secret; its price is the
  // price book's list price for its name (fragment_core::price
  // DEFAULT_KEYS) unless it names `"price": {"micros", "per"}`
  // (micro-dollars per calls, at list; the margin is added). An `own` row
  // takes the person's own key instead: pasted in settings, or, with an
  // `oauth` sign-in, made by the provider when the person connects it there
  // (`fragment_core::own_signin`); its `models` are what their agents may
  // run on, paid by their account at the provider.
  "providers": [
    { "name": "x", "kind": "operator", "hosts": ["api.x.com", "api.twitter.com"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["X_API_BEARER_TOKEN"], "key": "fragment-x-api-key" },
    { "name": "firecrawl", "kind": "operator", "hosts": ["api.firecrawl.dev"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["FIRECRAWL_API_KEY"], "key": "fragment-firecrawl-api-key" },
    { "name": "fal", "kind": "operator", "hosts": ["queue.fal.run", "fal.run", "rest.fal.ai"],
      "placements": [{ "header": "authorization", "format": "Key {}" }],
      "env": ["FAL_KEY"], "key": "fragment-fal-api-key" },
    { "name": "browser-use", "kind": "operator", "hosts": ["api.browser-use.com"],
      "placements": [{ "header": "x-browser-use-api-key" }],
      "env": ["BROWSER_USE_API_KEY"], "key": "fragment-browser-use-api-key" },
    { "name": "google", "kind": "connection",
      "hosts": ["gmail.googleapis.com", "www.googleapis.com", "people.googleapis.com", "sheets.googleapis.com", "docs.googleapis.com"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["GOOGLE_OAUTH_ACCESS_TOKEN"] },
    { "name": "perplexity", "kind": "operator", "hosts": ["api.perplexity.ai"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["PERPLEXITY_API_KEY"], "key": "fragment-perplexity-api-key" },
    { "name": "google-places", "kind": "operator", "hosts": ["places.googleapis.com"],
      "placements": [{ "header": "x-goog-api-key" }, { "query": "key" }],
      "env": ["GOOGLE_PLACES_API_KEY"], "key": "fragment-google-places-api-key" },
    { "name": "xai", "kind": "operator", "hosts": ["api.x.ai"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["XAI_API_KEY"], "key": "fragment-xai-api-key" },
    { "name": "elevenlabs", "kind": "operator", "hosts": ["api.elevenlabs.io"],
      "placements": [{ "header": "xi-api-key" }],
      "env": ["ELEVENLABS_API_KEY"], "key": "fragment-elevenlabs-api-key" },
    // The person's own OpenRouter account (Paul, 2026-10-08): connected from
    // settings through OpenRouter's own page (its PKCE key exchange: no key
    // pasted), and paid by their OpenRouter credit, never metered here. An
    // agent runs on one of its models when its agent.json names it
    // (`model: {provider, id}`); settings offers these, each one that calls
    // tools (OpenRouter's /api/v1/models, read 2026-10-08).
    { "name": "openrouter", "kind": "own", "hosts": ["openrouter.ai"],
      "placements": [{ "header": "authorization", "format": "Bearer {}" }],
      "env": ["OPENROUTER_API_KEY"],
      "oauth": { "authorize": "https://openrouter.ai/auth",
                 "exchange": "https://openrouter.ai/api/v1/auth/keys",
                 "manage": "https://openrouter.ai/settings/keys" },
      "models": { "base_url": "https://openrouter.ai/api/v1", "offer": [
        { "id": "anthropic/claude-sonnet-5.5", "name": "Claude Sonnet 5.5" },
        { "id": "anthropic/claude-haiku-5.5", "name": "Claude Haiku 5.5" },
        { "id": "anthropic/claude-opus-5.5", "name": "Claude Opus 5.5" },
        { "id": "openai/gpt-6.1-sol", "name": "GPT-6.1 Sol" },
        { "id": "deepseek/deepseek-v4.1-flash", "name": "DeepSeek V4.1 Flash" },
        { "id": "z-ai/glm-5.3", "name": "GLM-5.3" }
      ] } }
  ],
  // A branch deployment's test levers, for the hosted e2e (`cargo xtask
  // e2e --hosted`; docs/secrets.md): 32 random bytes or more, as text. A
  // --branch deploy only: a deployment of its own is refused. A file, not
  // a store secret: the hosted e2e sends its value, and a store gives none back.
  // CI's job writes the preview environment's PREVIEW_TEST_SECRET to this path.
  // "test_secret_file": "~/.config/fragment/secrets/preview-test-secret",
  // The book's version is the higher of this and the code's own
  // (fragment_core::price::DEFAULT_BOOK_VERSION, 7 since OpenRouter's
  // GLM-5.3 Flash was priced): raise it past both with every change to a
  // key's price, or ledgers keep their book.
  "price_book_version": 7
}
