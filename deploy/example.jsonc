// A deployment's configuration for `cargo xtask deploy --config <file>`
// (xtask/src/deploy.rs). Keep yours outside the repo: it names your
// account and where your secrets are. Every secret is a file read by path,
// never a value here.
{
  // Your Cloudflare account (`wrangler whoami`), and the zone the
  // deployment's routes are on. The zone needs one proxied wildcard DNS
  // record (`*` AAAA 100::), which Universal SSL covers.
  "account_id": "0123456789abcdef0123456789abcdef",
  "zone": "example.dev",
  // A Cloudflare API token with Zone · DNS · Edit on the zone(s) (and
  // Account · AI Gateway · Edit, to make the gateway below): with it, a
  // deploy makes that record when it is missing. Without it, make it by hand.
  // "dns_token_file": "~/.config/fragment/secrets/cloudflare-dns-token",
  // A deployment of its own names its hosts (production: "fragment.club"
  // and "fragment.boats", each a zone on the account). Without them,
  // `--branch <b>` deploys a branch at <b>.<zone>.
  // "platform_host": "fragment.club",
  // "fragment_suffix": "fragment.boats",
  // 32 random bytes or more, as text: seals every value at rest. Rotating:
  // the new one here, the old one stays a while as FRAGMENT_HOST_SECRET_PREVIOUS.
  "host_secret_file": "~/.config/fragment/secrets/host-secret",
  // Every fragment's git. The org's signing key, in PEM.
  "codestorage": {
    "org": "your-org",
    "private_key_file": "~/.config/fragment/secrets/codestorage-private-key.pem"
  },
  // Sign-in: a WorkOS environment with AuthKit on, its redirect URI
  // https://<platform>/auth/callback.
  "workos": {
    "client_id_file": "~/.config/fragment/secrets/workos-client-id",
    "api_key_file": "~/.config/fragment/secrets/workos-api-key"
  },
  // The AI Gateway the model route and image steps call through: one of
  // your own, named (never "default", which makes one that logs), with
  // Unified Billing, zero data retention on and its logs off. Without it,
  // models and images are off.
  // "ai_gateway": "fragment",
  // A new person's plan: guest (the default), seat, or seat_always_on.
  // "default_plan": "guest",
  // npubs that grant credit, set plans, seats and overdrafts, and release
  // usernames.
  "operators": [],
  // Computers (docs/computers.md): the images they run, by name, relative
  // to the repo, and the one a new computer is pinned to. Without this
  // the deployment makes no computers. The Hermes image builds from the
  // repo's root (it carries the fragment CLI); the stub, from images/.
  "computers": {
    "default_image": "hermes",
    "images": {
      "hermes": { "dockerfile": "images/hermes/Dockerfile", "build_context": "." }
    }
    // no size: a computer starts at decision 13's 2 vCPU and 6 GiB
  },
  // What a computer's swap offers: WorkOS Pipes providers (each enabled in
  // the WorkOS environment above) and the operator's keys, each with the
  // hosts it is for. A key's value is a file, as every secret.
  "connections": {
    "github": ["api.github.com"],
    "google-calendar": ["www.googleapis.com"]
  },
  "operator_keys": {
    // its price: micro-dollars per `per` calls, at list (the margin is added)
    "perplexity": { "hosts": ["api.perplexity.ai"], "key_file": "~/.config/fragment/secrets/perplexity-key", "price": { "micros": 5000, "per": 1 } }
  },
  // A branch deployment's test levers, for the hosted e2e (`cargo xtask
  // e2e --hosted`; docs/secrets.md): 32 random bytes or more, as text. A
  // --branch deploy only: a deployment of its own is refused.
  // "test_secret_file": "~/.config/fragment/secrets/preview-test-secret",
  // Raise with every change to a key's price, or ledgers keep their book.
  "price_book_version": 1
}
